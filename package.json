{
  "name": "archonnel-backend",
  "version": "1.0.0",
  "description": "Centralized Backend API and Gateway for Archon Nell Incorporated E-Commerce & ERP platform",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:seed:full": "tsx src/db/seed.ts --full",
    "db:seed:basic": "tsx src/db/seed.ts --basic"
  },
  "keywords": [
    "archonnell",
    "api-gateway",
    "centralized-backend",
    "postgresql",
    "capstone"
  ],
  "author": "Archon Nell Capstone Team",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.25.7"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.11.11",
    "@types/swagger-ui-express": "^4.1.8",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
