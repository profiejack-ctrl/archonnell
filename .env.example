# ==============================================================================
# Archon Nell Centralized Backend API - Environment Configuration
# ==============================================================================

# Server Configuration
PORT=4000
NODE_ENV=development

# Primary Database (VPS Local PostgreSQL - Fastest, <1ms latency)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/archon_central

# Secondary Database / Standby (Supabase Cloud Mirror / Remote Dashboard)
DATABASE_BACKUP_URL=postgresql://postgres:your_supabase_password@db.your-project.supabase.co:5432/postgres

# Enable automatic fallback to secondary if primary is unreachable
DB_FAILOVER_ENABLED=true

# JWT Authentication Secrets
JWT_SECRET=archon_nell_super_secret_jwt_key_capstone_2026_change_in_production
JWT_EXPIRES_IN=7d

# Cross-Subdomain Cookie Configuration
COOKIE_DOMAIN=.archonnell.com
COOKIE_SECRET=archon_nell_cookie_secret_2026

# Allowed Frontend Origins (Comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:3000,http://localhost:8000,https://shop.archonnell.com,https://hrms.archonnell.com,https://wfm.archonnell.com,https://payroll.archonnell.com,https://fleet.archonnell.com,https://archonnell.com

# ==============================================================================
# Outbound Email SMTP Configuration (For Cross-Module OTP & 2FA)
# ==============================================================================
# Options:
# 1. Gmail SMTP:
#    SMTP_HOST=smtp.gmail.com
#    SMTP_PORT=465
#    SMTP_SECURE=true
#    SMTP_USER=your-email@gmail.com
#    SMTP_PASS=your-16-char-gmail-app-password
#
# 2. Brevo / Sendinblue SMTP:
#    SMTP_HOST=smtp-relay.brevo.com
#    SMTP_PORT=587
#    SMTP_SECURE=false
#    SMTP_USER=your-brevo-login
#    SMTP_PASS=your-brevo-smtp-key
#
# 3. Development / Offline Mode:
#    Leave SMTP_HOST blank to print OTP codes directly to console and API dev responses.

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=no-reply@archonnell.com
SMTP_FROM_NAME="Archon Nell Incorporated"
OTP_EXPIRATION_MINUTES=5
